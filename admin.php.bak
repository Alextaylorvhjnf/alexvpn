    <style>
        @import url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css');
        :root {
            --bg:#060a1a;--bg2:#0c1030;--bg3:#111640;--card:rgba(12,16,48,0.8);--card2:rgba(17,22,64,0.9);
            --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.12);--border3:rgba(255,255,255,0.2);
            --text:#e8e8f2;--text2:#b8b8d0;--text3:#8080a0;
            --p1:#7c6ff7;--p2:#5b4fcf;--t1:#00d4cc;--a1:#ff6b9d;--w1:#fdcb6e;
            --grad1:linear-gradient(135deg,#7c6ff7,#5b4fcf);--grad2:linear-gradient(135deg,#7c6ff7,#00d4cc);
            --grad3:linear-gradient(135deg,#ff6b9d,#e85d75);--grad4:linear-gradient(135deg,#00b894,#00d4cc);
            --radius1:12px;--radius2:18px;--radius3:36px;--shadow1:0 4px 20px rgba(0,0,0,0.3);--shadow2:0 8px 32px rgba(0,0,0,0.5);
            --trans:0.3s cubic-bezier(0.4,0,0.2,1);
        }
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Vazirmatn',Tahoma,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.7;
            background-image:radial-gradient(ellipse at top,rgba(124,111,247,0.06),transparent 60%),radial-gradient(ellipse at bottom right,rgba(0,212,204,0.04),transparent 60%);}
        .login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:radial-gradient(circle at center,rgba(124,111,247,0.1),transparent 70%)}
        .login-card{background:var(--card);border:1px solid var(--border2);border-radius:28px;padding:48px 36px;width:100%;max-width:420px;backdrop-filter:blur(30px);box-shadow:0 20px 60px rgba(0,0,0,0.5),0 0 80px rgba(124,111,247,0.08);text-align:center}
        .login-card .logo-icon{width:64px;height:64px;margin:0 auto 20px}
        .login-card .logo-icon svg{width:100%;height:100%;filter:drop-shadow(0 0 20px rgba(124,111,247,0.5))}
        .login-card h1{font-size:1.6rem;font-weight:900;margin-bottom:6px}
        .login-card .sub{color:var(--text3);font-size:.88rem;margin-bottom:28px}
        .login-card input{width:100%;padding:14px 20px;border-radius:16px;border:2px solid var(--border2);background:rgba(255,255,255,0.03);color:#fff;font-size:1rem;font-family:inherit;text-align:center;transition:var(--trans);outline:none}
        .login-card input:focus{border-color:var(--p1);box-shadow:0 0 25px rgba(124,111,247,0.2)}
        .login-card .btn{width:100%;margin-top:20px}
        .admin-wrap{max-width:1300px;margin:0 auto;padding:0 20px}
        .admin-header{position:sticky;top:0;z-index:100;backdrop-filter:blur(30px) saturate(180%);background:rgba(6,10,26,0.8);border-bottom:1px solid var(--border);padding:12px 0;margin-bottom:20px}
        .admin-header .inner{max-width:1300px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
        .admin-header .brand{display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--text);font-weight:900;font-size:1.1rem}
        .admin-header .brand svg{width:34px;height:34px}
        .admin-header .brand span{background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .admin-header .actions{display:flex;gap:8px;flex-wrap:wrap}
        .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:var(--radius3);font-weight:700;font-size:.85rem;text-decoration:none;border:none;cursor:pointer;transition:var(--trans);font-family:inherit;white-space:nowrap}
        .btn-primary{background:var(--grad1);color:#fff;box-shadow:0 0 25px rgba(124,111,247,0.3)}
        .btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 40px rgba(124,111,247,0.5)}
        .btn-success{background:var(--grad4);color:#fff}
        .btn-danger{background:var(--grad3);color:#fff}
        .btn-outline{background:transparent;border:1px solid var(--border2);color:var(--text2)}
        .btn-outline:hover{border-color:var(--border3);background:rgba(255,255,255,0.04)}
        .btn-xs{padding:5px 10px;font-size:.7rem;border-radius:18px}
        .btn-sm{padding:7px 14px;font-size:.78rem}
        .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px}
        .stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius2);padding:20px 18px;backdrop-filter:blur(20px);transition:var(--trans);position:relative;overflow:hidden}
        .stat-card::before{content:'';position:absolute;top:-15px;right:-15px;width:60px;height:60px;border-radius:50%;opacity:0.06;transition:var(--trans)}
        .stat-card:hover{transform:translateY(-3px);border-color:var(--border3)}
        .stat-card:hover::before{opacity:0.12;transform:scale(1.4)}
        .stat-card.s1::before{background:#7c6ff7}.stat-card.s2::before{background:#00d4cc}.stat-card.s3::before{background:#ff6b9d}.stat-card.s4::before{background:#fdcb6e}.stat-card.s5::before{background:#e17055}
        .stat-card .stat-icon{font-size:1.4rem;margin-bottom:6px}
        .stat-card .stat-value{font-size:1.5rem;font-weight:900}
        .stat-card .stat-label{color:var(--text3);font-size:.75rem}
        .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius2);padding:22px;backdrop-filter:blur(20px);margin-bottom:18px}
        .card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px}
        .card-header h3{font-size:1.15rem;font-weight:900;display:flex;align-items:center;gap:8px}
        .tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px}
