        .server-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;background:rgba(0,0,0,0.2);padding:8px 12px;border-radius:10px}
        .server-row .flag{font-size:1.5rem;width:40px}.server-row .name{width:90px;font-size:.85rem}.server-row input{flex:1}
        @media(max-width:768px){.form-grid{grid-template-columns:1fr}.stats-grid{grid-template-columns:repeat(2,1fr)}}
        @media(max-width:480px){.stats-grid{grid-template-columns:1fr}.tabs{flex-wrap:nowrap;overflow-x:auto}}
        ::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
        ::selection{background:rgba(124,111,247,0.3);color:#fff}
    </style>
</head>
