<?php
require_once __DIR__ . '/config.php';

$countries = $GLOBALS['COUNTRIES'];

// Auth
$isLoggedIn = false;
if (isset($_POST['password']) && $_POST['password'] === ADMIN_PASSWORD) {
    $_SESSION['admin_logged_in'] = true;
    $_SESSION['admin_login_time'] = time();
}
if (isset($_GET['logout'])) {
    session_destroy();
    header('Location: /admin');
    exit;
}
if (isset($_SESSION['admin_login_time']) && (time() - $_SESSION['admin_login_time'] > 28800)) {
    session_destroy();
    header('Location: /admin');
    exit;
}
$isLoggedIn = isset($_SESSION['admin_logged_in']) && $_SESSION['admin_logged_in'];

if (!isset($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
}

$message = '';
$messageType = 'success';
$settings = loadSettings();
$servers = loadServers();

if ($isLoggedIn) {
    if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['csrf_token'])) {
        if ($_POST['csrf_token'] !== $_SESSION['csrf_token']) die('CSRF validation failed');
    }
    
    // Save settings
    if (isset($_POST['save_settings'])) {
        $settings['card_number'] = trim($_POST['card_number'] ?? '');
        $settings['card_holder'] = trim($_POST['card_holder'] ?? '');
        $settings['card_bank'] = trim($_POST['card_bank'] ?? '');
        $settings['zarinpal_enabled'] = isset($_POST['zarinpal_enabled']);
        $settings['card_enabled'] = isset($_POST['card_enabled']);
        saveSettings($settings);
        $message = 'تنظیمات پرداخت ذخیره شد.'; $messageType = 'success';
    }
    
    // Save servers
    if (isset($_POST['save_servers'])) {
        $newServers = [];
        foreach ($countries as $code => $c) {
            $inboundStr = trim($_POST['inbounds_' . $code] ?? '');
            if (!empty($inboundStr)) {
                $inbounds = array_values(array_filter(array_map('intval', explode(',', $inboundStr))));
                if (!empty($inbounds)) $newServers[] = ['location' => $code, 'location_name' => $c['name'], 'inbounds' => $inbounds];
            }
        }
        saveServers($newServers); $servers = $newServers;
        $message = 'تنظیمات سرورها ذخیره شد.'; $messageType = 'success';
    }
    
    // Add plan
    if (isset($_POST['add_plan'])) {
        $plans = loadPlans(); $loc = trim($_POST['location'] ?? '');
        $newPlan = [
            'id' => 'plan_' . time() . '_' . bin2hex(random_bytes(4)),
            'name' => trim($_POST['name'] ?? ''), 'location' => $loc,
            'location_name' => $countries[$loc]['name'] ?? trim($_POST['location_name'] ?? ''),
            'location_emoji' => $countries[$loc]['emoji'] ?? '🌍',
            'volume' => max(1, (int)($_POST['volume'] ?? 0)), 'days' => max(1, (int)($_POST['days'] ?? 0)),
            'price' => max(1000, (int)($_POST['price'] ?? 0)),
            'inbounds' => getInboundsForLocation($loc) ?: ALL_INBOUNDS,
            'active' => true, 'featured' => isset($_POST['featured']), 'created_at' => date('Y-m-d H:i:s')
        ];
        if (empty($newPlan['name']) || empty($newPlan['location'])) {
            $message = 'لطفا فیلدهای ضروری را پر کنید.'; $messageType = 'error';
        } else { $plans[] = $newPlan; savePlans($plans); $message = 'پلن اضافه شد.'; $messageType = 'success'; }
    }
    
    // Edit plan
    if (isset($_POST['edit_plan'])) {
        $plans = loadPlans(); $editId = $_POST['plan_id'] ?? '';
        foreach ($plans as &$plan) {
            if ($plan['id'] === $editId) {
                $loc = trim($_POST['location'] ?? $plan['location']);
                $plan['name'] = trim($_POST['name'] ?? $plan['name']); $plan['location'] = $loc;
                $plan['location_name'] = $countries[$loc]['name'] ?? trim($_POST['location_name'] ?? $plan['location_name']);
                $plan['location_emoji'] = $countries[$loc]['emoji'] ?? ($plan['location_emoji'] ?? '🌍');
                $plan['volume'] = max(1, (int)($_POST['volume'] ?? $plan['volume']));
                $plan['days'] = max(1, (int)($_POST['days'] ?? $plan['days']));
                $plan['price'] = max(1000, (int)($_POST['price'] ?? $plan['price']));
                $plan['inbounds'] = getInboundsForLocation($loc) ?: ALL_INBOUNDS;
                $plan['featured'] = isset($_POST['featured']); $plan['updated_at'] = date('Y-m-d H:i:s');
                $message = 'پلن ویرایش شد.'; $messageType = 'success'; break;
            }
        }
        savePlans($plans);
    }
    
    // Delete / Toggle / Duplicate
    if (isset($_GET['delete']) && isset($_GET['confirm'])) {
        $plans = loadPlans(); $plans = array_values(array_filter($plans, fn($p) => $p['id'] !== $_GET['delete']));
        savePlans($plans); $message = 'پلن حذف شد.'; $messageType = 'success';
    }
    if (isset($_GET['toggle'])) {
        $plans = loadPlans();
        foreach ($plans as &$p) { if ($p['id'] === $_GET['toggle']) { $p['active'] = !($p['active'] ?? true); break; } }
        savePlans($plans); $message = 'وضعیت تغییر کرد.'; $messageType = 'info';
    }
    if (isset($_GET['duplicate'])) {
        $plans = loadPlans();
        foreach ($plans as $p) {
            if ($p['id'] === $_GET['duplicate']) {
                $np = $p; $np['id'] = 'plan_' . time() . '_' . bin2hex(random_bytes(4));
                $np['name'] = $p['name'] . ' (کپی)'; $np['created_at'] = date('Y-m-d H:i:s');
                unset($np['updated_at']); $plans[] = $np; break;
            }
        }
        savePlans($plans); $message = 'پلن کپی شد.'; $messageType = 'success';
    }
}

$plans = loadPlans();
$orders = loadOrders();
$pendingPayments = loadPending();
$pendingList = array_filter($pendingPayments, fn($p) => ($p['status'] ?? '') === 'pending');
$totalRevenue = array_sum(array_column($orders, 'amount'));
$activePlans = count(array_filter($plans, fn($p) => $p['active'] ?? true));
$totalPlans = count($plans);
$totalOrders = count($orders);
$pendingCount = count($pendingList);
?>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
