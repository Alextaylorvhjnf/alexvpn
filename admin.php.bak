        .badge-success{background:rgba(0,212,204,0.1);color:var(--t1)}.badge-danger{background:rgba(255,107,157,0.1);color:var(--a1)}.badge-info{background:rgba(124,111,247,0.1);color:var(--p1)}.badge-warning{background:rgba(253,203,110,0.1);color:var(--w1)}
        .alert{padding:12px 18px;border-radius:14px;margin-bottom:18px;font-size:.88rem;font-weight:600;display:flex;align-items:center;gap:8px}
        .alert-success{background:rgba(0,212,204,0.08);border:1px solid rgba(0,212,204,0.25);color:var(--t1)}
        .alert-error{background:rgba(255,107,157,0.08);border:1px solid rgba(255,107,157,0.25);color:var(--a1)}
        .alert-info{background:rgba(124,111,247,0.08);border:1px solid rgba(124,111,247,0.25);color:var(--p1)}
        .modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;z-index:200;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:20px}
        .modal{background:var(--bg2);border:1px solid var(--border2);border-radius:22px;padding:28px 22px;max-width:550px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px rgba(0,0,0,0.6);position:relative}
        .modal h3{font-size:1.2rem;font-weight:900;margin-bottom:16px;text-align:center}
        .modal .close-btn{position:absolute;top:12px;left:16px;background:none;border:none;color:var(--text3);font-size:1.4rem;cursor:pointer}
