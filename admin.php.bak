        <?php if(empty($plans)): ?><p style="text-align:center;color:var(--text3);padding:30px;">پلنی وجود ندارد.</p>
        <?php else: ?><div class="table-wrap"><table><thead><tr><th>نام</th><th>لوکیشن</th><th>حجم</th><th>مدت</th><th>قیمت</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
        <?php foreach($plans as $plan): ?><tr>
            <td><strong><?php echo htmlspecialchars($plan['name']); ?></strong> <?php echo ($plan['featured']??false)?'⭐':''; ?></td>
            <td><span style="font-size:1.2rem;"><?php echo htmlspecialchars($plan['location_emoji']??'🌍'); ?></span> <?php echo htmlspecialchars($plan['location_name']??$plan['location']); ?></td>
            <td><?php echo (int)$plan['volume']; ?> GB</td><td><?php echo (int)$plan['days']; ?> روز</td>
            <td><strong><?php echo number_format((int)$plan['price']); ?></strong> ت</td>
            <td><span class="badge <?php echo ($plan['active']??true)?'badge-success':'badge-danger'; ?>"><?php echo ($plan['active']??true)?'فعال':'غیرفعال'; ?></span></td>
            <td><div style="display:flex;gap:5px;flex-wrap:wrap;">
                <button class="btn btn-outline btn-xs" onclick="editPlan('<?php echo $plan['id']; ?>','<?php echo htmlspecialchars(addslashes($plan['name'])); ?>','<?php echo $plan['location']; ?>','<?php echo (int)$plan['volume']; ?>','<?php echo (int)$plan['days']; ?>','<?php echo (int)$plan['price']; ?>',<?php echo ($plan['featured']??false)?'true':'false'; ?>)">✏️</button>
                <a href="?toggle=<?php echo $plan['id']; ?>" class="btn btn-outline btn-xs">🔄</a>
                <a href="?duplicate=<?php echo $plan['id']; ?>" class="btn btn-outline btn-xs">📋</a>
                <a href="?delete=<?php echo $plan['id']; ?>&confirm=yes" class="btn btn-danger btn-xs" onclick="return confirm('حذف شود؟')">🗑️</a>
            </div></td>
        </tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div>

    <!-- Add tab -->
    <div class="tab-content" id="tab-add"><div class="card"><div class="card-header"><h3>➕ افزودن پلن</h3></div>
        <form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="add_plan" value="1">
            <div class="form-grid">
                <div class="form-group"><label>نام پلن *</label><input type="text" name="name" placeholder="پلن اقتصادی" required></div>
                <div class="form-group"><label>کشور *</label><select name="location" required onchange="updateFlagPreview(this.value)"><option value="">انتخاب...</option><?php foreach($countries as $code=>$c): ?><option value="<?php echo $code; ?>"><?php echo $c['emoji']; ?> <?php echo $c['name']; ?></option><?php endforeach; ?></select></div>
                <div class="form-group"><label>حجم (GB)</label><input type="number" name="volume" value="30" min="1" required></div>
                <div class="form-group"><label>مدت (روز)</label><input type="number" name="days" value="30" min="1" required></div>
                <div class="form-group"><label>قیمت (تومان)</label><input type="number" name="price" value="150000" min="1000" required></div>
            </div>
            <div class="loc-flag-preview" id="flagPreview">🌍</div>
            <div class="form-group"><div class="checkbox-group"><input type="checkbox" name="featured" id="feat"><label for="feat" style="margin:0;">⭐ پلن محبوب</label></div></div>
            <button type="submit" class="btn btn-success">افزودن</button>
        </form>
    </div></div>

    <!-- Pending tab -->
    <div class="tab-content" id="tab-pending"><div class="card"><div class="card-header"><h3>⏳ پرداخت‌های در انتظار (<?php echo $pendingCount; ?>)</h3></div>
        <?php if(empty($pendingList)): ?><p style="text-align:center;color:var(--text3);padding:30px;">موردی نیست.</p>
        <?php else: ?><div class="table-wrap"><table><thead><tr><th>کاربر</th><th>پلن</th><th>مبلغ</th><th>زمان</th><th>رسید</th><th>عملیات</th></tr></thead><tbody>
        <?php foreach(array_reverse($pendingList) as $pp): ?><tr>
            <td><?php echo htmlspecialchars($pp['user_name']??''); ?><br><small style="color:var(--text3);"><?php echo htmlspecialchars($pp['user_email']??''); ?></small></td>
            <td><?php echo htmlspecialchars($pp['plan_name']??''); ?><br><small style="color:var(--text3);"><?php echo htmlspecialchars($pp['location_name']??''); ?></small></td>
            <td><strong><?php echo number_format((int)($pp['price']??0)); ?></strong> ت</td>
            <td><?php echo htmlspecialchars($pp['created_at']??''); ?></td>
            <td><?php if(!empty($pp['receipt'])): ?><a href="/data/receipts/<?php echo basename($pp['receipt']); ?>" target="_blank" class="btn btn-outline btn-xs">📸</a><?php endif; ?></td>
            <td><div style="display:flex;gap:5px;">
                <form method="post" action="/admin-approve.php" style="display:inline;"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="pending_id" value="<?php echo $pp['id']; ?>"><button type="submit" name="action" value="approve" class="btn btn-success btn-xs">✅ تایید</button></form>
                <button class="btn btn-danger btn-xs" onclick="rejectPayment('<?php echo $pp['id']; ?>')">❌ رد</button>
            </div></td>
        </tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div>

    <!-- Servers tab -->
    <div class="tab-content" id="tab-servers"><div class="card"><div class="card-header"><h3>🖥️ Inbound های هر لوکیشن</h3></div>
        <form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="save_servers" value="1">
            <p style="color:var(--text3);font-size:.82rem;margin-bottom:14px;">شماره Inbound ها را با کاما جدا کنید (مثال: 2,3,4,5)</p>
            <?php foreach($countries as $code=>$c): $cur=''; foreach($servers as $s){if(($s['location']??'')===$code){$cur=implode(',',$s['inbounds']??[]);break;}} ?>
            <div class="server-row"><span class="flag"><?php echo $c['emoji']; ?></span><span class="name"><?php echo $c['name']; ?></span><input type="text" name="inbounds_<?php echo $code; ?>" value="<?php echo $cur; ?>" placeholder="2,3,4,5" dir="ltr"></div>
            <?php endforeach; ?>
            <button type="submit" class="btn btn-primary" style="margin-top:14px;">💾 ذخیره</button>
        </form>
    </div></div>

    <!-- Settings tab -->
    <div class="tab-content" id="tab-settings"><div class="card"><div class="card-header"><h3>⚙️ تنظیمات پرداخت</h3></div>
        <form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="save_settings" value="1">
            <h4 style="margin-bottom:12px;color:var(--p1);">💳 کارت به کارت</h4>
            <div class="form-grid">
                <div class="form-group"><label>شماره کارت</label><input type="text" name="card_number" value="<?php echo htmlspecialchars($settings['card_number']??''); ?>" dir="ltr"></div>
                <div class="form-group"><label>نام صاحب کارت</label><input type="text" name="card_holder" value="<?php echo htmlspecialchars($settings['card_holder']??''); ?>"></div>
                <div class="form-group"><label>نام بانک</label><input type="text" name="card_bank" value="<?php echo htmlspecialchars($settings['card_bank']??''); ?>"></div>
            </div>
            <div class="card-info-box"><p style="color:var(--text3);font-size:.75rem;">پیش‌نمایش:</p><p class="cnum"><?php echo htmlspecialchars($settings['card_number']?:'----'); ?></p><p style="color:var(--text2);"><?php echo htmlspecialchars($settings['card_holder']?:'---'); ?></p><p style="color:var(--text3);"><?php echo htmlspecialchars($settings['card_bank']?:'---'); ?></p></div>
            <h4 style="margin:16px 0 12px;color:var(--p1);">🔌 روش‌های پرداخت</h4>
            <div class="form-group"><div class="checkbox-group"><input type="checkbox" name="zarinpal_enabled" id="ze" <?php echo ($settings['zarinpal_enabled']??true)?'checked':''; ?>><label for="ze">درگاه زرین‌پال</label></div></div>
            <div class="form-group"><div class="checkbox-group"><input type="checkbox" name="card_enabled" id="ce" <?php echo ($settings['card_enabled']??true)?'checked':''; ?>><label for="ce">کارت به کارت</label></div></div>
            <button type="submit" class="btn btn-primary">💾 ذخیره</button>
        </form>
    </div></div>

    <!-- Orders tab -->
    <div class="tab-content" id="tab-orders"><div class="card"><div class="card-header"><h3>📊 سفارشات (<?php echo $totalOrders; ?>)</h3></div>
        <?php if(empty($orders)): ?><p style="text-align:center;color:var(--text3);padding:30px;">سفارشی ثبت نشده.</p>
        <?php else: ?><div class="table-wrap"><table><thead><tr><th>تاریخ</th><th>کد</th><th>کاربر</th><th>محصول</th><th>مبلغ</th><th>لینک</th></tr></thead><tbody>
        <?php foreach(array_reverse($orders) as $o): ?><tr>
            <td><?php echo htmlspecialchars($o['date']??''); ?></td>
            <td style="font-family:monospace;direction:ltr;"><?php echo htmlspecialchars(substr($o['ref_id']??'',-12)); ?></td>
            <td style="font-family:monospace;direction:ltr;"><?php echo htmlspecialchars($o['username']??'-'); ?></td>
            <td><?php echo htmlspecialchars($o['product']??'-'); ?></td>
            <td><strong><?php echo number_format((int)($o['amount']??0)); ?></strong> ت</td>
            <td><?php if(!empty($o['subscription_url'])): ?><a href="<?php echo htmlspecialchars($o['subscription_url']); ?>" target="_blank" class="btn btn-outline btn-xs">🔗</a><?php else: ?>-<?php endif; ?></td>
        </tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal" style="display:none;"><div class="modal">
    <button class="close-btn" onclick="closeEdit()">✕</button><h3>✏️ ویرایش پلن</h3>
    <form method="post" id="editForm"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="edit_plan" value="1"><input type="hidden" name="plan_id" id="eId">
        <div class="form-grid">
            <div class="form-group"><label>نام</label><input type="text" name="name" id="eName" required></div>
            <div class="form-group"><label>کشور</label><select name="location" id="eLoc" required onchange="updateEditFlag(this.value)"><?php foreach($countries as $code=>$c): ?><option value="<?php echo $code; ?>"><?php echo $c['emoji']; ?> <?php echo $c['name']; ?></option><?php endforeach; ?></select></div>
            <div class="form-group"><label>حجم</label><input type="number" name="volume" id="eVol" min="1" required></div>
            <div class="form-group"><label>مدت</label><input type="number" name="days" id="eDays" min="1" required></div>
            <div class="form-group"><label>قیمت</label><input type="number" name="price" id="ePrice" min="1000" required></div>
        </div>
        <div class="loc-flag-preview" id="editFlagPreview">🌍</div>
        <div class="form-group"><div class="checkbox-group"><input type="checkbox" name="featured" id="eFeat"><label for="eFeat">⭐ محبوب</label></div></div>
        <div style="display:flex;gap:8px;justify-content:flex-end;"><button type="button" class="btn btn-outline" onclick="closeEdit()">انصراف</button><button type="submit" class="btn btn-primary">ذخیره</button></div>
    </form>
</div></div>

<!-- Reject Modal -->
<div class="modal-overlay" id="rejectModal" style="display:none;"><div class="modal">
    <button class="close-btn" onclick="document.getElementById('rejectModal').style.display='none'">✕</button><h3>❌ رد پرداخت</h3>
    <form method="post" action="/admin-approve.php"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="action" value="reject"><input type="hidden" name="pending_id" id="rejectPendingId">
        <div class="form-group"><label>دلیل رد</label><input type="text" name="reject_reason" placeholder="دلیل را وارد کنید" required></div>
        <button type="submit" class="btn btn-danger" style="width:100%;">ثبت</button>
    </form>
</div></div>
<?php endif; ?>

<script>
const countryFlags = <?php echo json_encode(array_map(fn($c)=>$c['emoji'], $countries)); ?>;
function updateFlagPreview(code){document.getElementById('flagPreview').textContent=countryFlags[code]||'🌍';}
function updateEditFlag(code){document.getElementById('editFlagPreview').textContent=countryFlags[code]||'🌍';}
function editPlan(id,name,loc,vol,days,price,feat){
    document.getElementById('eId').value=id;document.getElementById('eName').value=name;document.getElementById('eLoc').value=loc;
    document.getElementById('eVol').value=vol;document.getElementById('eDays').value=days;document.getElementById('ePrice').value=price;
    document.getElementById('eFeat').checked=feat;document.getElementById('editFlagPreview').textContent=countryFlags[loc]||'🌍';
    document.getElementById('editModal').style.display='flex';
}
function closeEdit(){document.getElementById('editModal').style.display='none';}
document.getElementById('editModal').addEventListener('click',function(e){if(e.target===this)closeEdit();});
function rejectPayment(id){document.getElementById('rejectPendingId').value=id;document.getElementById('rejectModal').style.display='flex';}
document.getElementById('rejectModal').addEventListener('click',function(e){if(e.target===this)this.style.display='none';});
document.querySelectorAll('.tab-btn').forEach(b=>{b.addEventListener('click',function(){
    document.querySelectorAll('.tab-btn').forEach(bb=>bb.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));
    this.classList.add('active');document.getElementById('tab-'+this.dataset.tab).classList.add('active');
});});
</script>
</body>
</html>
