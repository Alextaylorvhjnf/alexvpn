<?php
require_once __DIR__ . '/config.php';

$allFlags = ['germany'=>'🇩🇪','usa'=>'🇺🇸','turkey'=>'🇹🇷','sweden'=>'🇸🇪','azerbaijan'=>'🇦🇿','netherlands'=>'🇳🇱','france'=>'🇫🇷','uk'=>'🇬🇧','canada'=>'🇨🇦','spain'=>'🇪🇸','italy'=>'🇮🇹','japan'=>'🇯🇵','singapore'=>'🇸🇬','uae'=>'🇦🇪','russia'=>'🇷🇺','switzerland'=>'🇨🇭','poland'=>'🇵🇱','finland'=>'🇫🇮','norway'=>'🇳🇴','denmark'=>'🇩🇰','austria'=>'🇦🇹','belgium'=>'🇧🇪','portugal'=>'🇵🇹','brazil'=>'🇧🇷','india'=>'🇮🇳','australia'=>'🇦🇺','south_korea'=>'🇰🇷','romania'=>'🇷🇴','ukraine'=>'🇺🇦','czech'=>'🇨🇿'];

$isLoggedIn = false;
$adminFile = __DIR__ . '/data/admin.json';
if (isset($_POST['email']) && isset($_POST['password'])) { if (file_exists($adminFile)) { $adminData = json_decode(file_get_contents($adminFile), true); if ($adminData && $adminData['email'] === $_POST['email'] && password_verify($_POST['password'], $adminData['password'])) { $_SESSION['admin_logged_in'] = true; $_SESSION['admin_email'] = $adminData['email']; $_SESSION['admin_login_time'] = time(); } } }
if (isset($_GET['logout'])) { session_destroy(); header('Location: /admin'); exit; }
if (isset($_SESSION['admin_login_time']) && (time() - $_SESSION['admin_login_time'] > 28800)) { session_destroy(); header('Location: /admin'); exit; }
$isLoggedIn = isset($_SESSION['admin_logged_in']) && $_SESSION['admin_logged_in'];
if (!isset($_SESSION['csrf_token'])) { $_SESSION['csrf_token'] = bin2hex(random_bytes(32)); }

$message = ''; $messageType = 'success';
$settings = loadSettings(); $servers = loadServers();

if ($isLoggedIn) {
    if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['csrf_token'])) { if ($_POST['csrf_token'] !== $_SESSION['csrf_token']) die('CSRF'); }
    
    if (isset($_POST['save_settings'])) { $settings['card_number']=trim($_POST['card_number']??'');$settings['card_holder']=trim($_POST['card_holder']??'');$settings['card_bank']=trim($_POST['card_bank']??'');$settings['zarinpal_enabled']=isset($_POST['zarinpal_enabled']);$settings['card_enabled']=isset($_POST['card_enabled']);saveSettings($settings);$message='Settings saved.';$messageType='success'; }
    
    if (isset($_POST['save_servers'])) { $newServers=[];$snames=$_POST['server_name']??[];$scodes=$_POST['server_code']??[];$sinbounds=$_POST['server_inbounds']??[];$sflags=$_POST['server_flag']??[];foreach($snames as $i=>$name){$name=trim($name);$code=trim($scodes[$i]??'');$ib=trim($sinbounds[$i]??'');$flag=trim($sflags[$i]??'🌍');if(!empty($name)&&!empty($code)&&!empty($ib)){$inbounds=array_values(array_filter(array_map('intval',explode(',',$ib))));if(!empty($inbounds))$newServers[]=['location'=>$code,'location_name'=>$name,'location_emoji'=>$flag,'inbounds'=>$inbounds];}}saveServers($newServers);$servers=$newServers;$message='Servers saved.';$messageType='success'; }
    
    // ADD PLAN - supports multi-location
    if (isset($_POST['add_plan'])) {
        $plans=loadPlans();$sl=$_POST['server_locations']??[];
        if(empty($sl)){$message='Select at least one server.';$messageType='error';}
        else{$ai=[];$ln=[];$le=[];foreach($sl as $loc){foreach($servers as $s){if($s['location']===$loc){$ai=array_merge($ai,$s['inbounds']);$ln[]=$s['location_name'];$le[]=$s['location_emoji'];break;}}}$ai=array_values(array_unique($ai));$np=['id'=>'plan_'.time().'_'.bin2hex(random_bytes(4)),'name'=>trim($_POST['name']??''),'location'=>$sl[0],'locations'=>$sl,'location_name'=>implode(' + ',$ln),'location_emoji'=>implode(' ',$le),'volume'=>max(1,(int)($_POST['volume']??0)),'days'=>max(1,(int)($_POST['days']??0)),'price'=>max(1000,(int)($_POST['price']??0)),'inbounds'=>$ai,'active'=>true,'featured'=>isset($_POST['featured']),'created_at'=>date('Y-m-d H:i:s'),'multi_location'=>count($sl)>1];$plans[]=$np;savePlans($plans);$message='Plan added.';$messageType='success';}
    }
    
    // EDIT PLAN - supports multi-location
    if (isset($_POST['edit_plan'])) { $plans=loadPlans();$eid=$_POST['plan_id']??'';foreach($plans as &$p){if($p['id']===$eid){$sl=$_POST['server_locations']??[];if(!empty($sl)){$ai=[];$ln=[];$le=[];foreach($sl as $loc){foreach($servers as $s){if($s['location']===$loc){$ai=array_merge($ai,$s['inbounds']);$ln[]=$s['location_name'];$le[]=$s['location_emoji'];break;}}}$ai=array_values(array_unique($ai));$p['locations']=$sl;$p['location']=$sl[0];$p['location_name']=implode(' + ',$ln);$p['location_emoji']=implode(' ',$le);$p['inbounds']=$ai;$p['multi_location']=count($sl)>1;}$p['name']=trim($_POST['name']??$p['name']);$p['volume']=max(1,(int)($_POST['volume']??$p['volume']));$p['days']=max(1,(int)($_POST['days']??$p['days']));$p['price']=max(1000,(int)($_POST['price']??$p['price']));$p['featured']=isset($_POST['featured']);$p['updated_at']=date('Y-m-d H:i:s');$message='Plan updated.';$messageType='success';break;}}savePlans($plans); }
    
    if(isset($_GET['delete'])&&isset($_GET['confirm'])){$plans=loadPlans();$plans=array_values(array_filter($plans,fn($p)=>$p['id']!==$_GET['delete']));savePlans($plans);$message='Deleted.';}
    if(isset($_GET['toggle'])){$plans=loadPlans();foreach($plans as &$p){if($p['id']===$_GET['toggle']){$p['active']=!($p['active']??true);break;}}savePlans($plans);header('Location: /admin');exit;}
    if(isset($_GET['duplicate'])){$plans=loadPlans();foreach($plans as $p){if($p['id']===$_GET['duplicate']){$np=$p;$np['id']='plan_'.time().'_'.bin2hex(random_bytes(4));$np['name']=$p['name'].' (Copy)';$np['created_at']=date('Y-m-d H:i:s');unset($np['updated_at']);$plans[]=$np;break;}}savePlans($plans);$message='Duplicated.';}
    if(isset($_POST['reset_stats'])&&$_POST['reset_stats']==='CONFIRM'){saveOrders([]);savePending([]);$message='Stats reset.';$messageType='success';}
}

$plans=loadPlans();$orders=loadOrders();$pp=loadPending();$pendingList=array_filter($pp,fn($p)=>($p['status']??'')==='pending');
$tr=array_sum(array_column($orders,'amount'));$ap=count(array_filter($plans,fn($p)=>$p['active']??true));
$tp=count($plans);$to=count($orders);$pc=count($pendingList);$ts=count($servers);
?>
<!DOCTYPE html><html lang="en" dir="ltr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Panel | AlexVPN</title><meta name="robots" content="noindex"><link rel="manifest" href="/manifest.json"><link rel="icon" href="/alexvpn.png"><meta name="theme-color" content="#060a1a">
<style>@import url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css');
:root{--bg:#060a1a;--bg2:#0c1030;--card:rgba(12,16,48,0.8);--border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.12);--text:#e8e8f2;--text2:#b8b8d0;--text3:#8080a0;--p1:#7c6ff7;--t1:#00d4cc;--a1:#ff6b9d;--grad1:linear-gradient(135deg,#7c6ff7,#5b4fcf);--grad3:linear-gradient(135deg,#ff6b9d,#e85d75);--grad4:linear-gradient(135deg,#00b894,#00d4cc);--trans:0.3s ease}*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Vazirmatn',Tahoma,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.7}
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}.login-card{background:var(--card);border:1px solid var(--border2);border-radius:28px;padding:40px 32px;width:100%;max-width:420px;backdrop-filter:blur(30px);box-shadow:0 20px 60px rgba(0,0,0,0.5);text-align:center}.login-card img{width:56px;height:56px;margin-bottom:16px}.login-card h1{font-weight:900;font-size:1.4rem}.login-card input{width:100%;padding:13px 16px;border-radius:14px;border:2px solid var(--border2);background:rgba(255,255,255,0.03);color:#fff;font-family:inherit;font-size:.9rem;margin-bottom:10px;transition:var(--trans);outline:none;text-align:left;direction:ltr}.login-card input:focus{border-color:var(--p1)}
.admin-wrap{max-width:1300px;margin:0 auto;padding:0 20px}.admin-header{position:sticky;top:0;z-index:100;backdrop-filter:blur(30px);background:rgba(6,10,26,0.8);border-bottom:1px solid var(--border);padding:10px 0;margin-bottom:20px}.admin-header .inner{max-width:1300px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:32px;font-weight:700;font-size:.82rem;text-decoration:none;border:none;cursor:pointer;transition:var(--trans);font-family:inherit;white-space:nowrap}.btn-primary{background:var(--grad1);color:#fff}.btn-success{background:var(--grad4);color:#fff}.btn-danger{background:var(--grad3);color:#fff}.btn-outline{background:transparent;border:1px solid var(--border2);color:var(--text2)}.btn-outline:hover{background:rgba(255,255,255,0.03)}.btn-xs{padding:5px 10px;font-size:.68rem;border-radius:18px}.btn-sm{padding:7px 13px;font-size:.75rem}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px}.stat-card{background:var(--card);border:1px solid var(--border);border-radius:22px;padding:18px 16px}.stat-card .v{font-size:1.5rem;font-weight:900}.stat-card .l{color:var(--text3);font-size:.72rem}
.card{background:var(--card);border:1px solid var(--border);border-radius:22px;padding:20px;backdrop-filter:blur(20px);margin-bottom:16px}.tabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:16px}.tab-btn{padding:8px 15px;border-radius:22px;background:transparent;color:var(--text2);border:1px solid var(--border);cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:600;transition:var(--trans)}.tab-btn.active{background:rgba(124,111,247,0.12);border-color:var(--p1);color:#fff}.tab-content{display:none}.tab-content.active{display:block;animation:fadeIn .3s ease}@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-group{margin-bottom:12px}.form-group label{display:block;margin-bottom:4px;color:var(--text2);font-size:.8rem;font-weight:600}.form-group input,.form-group select{width:100%;padding:10px 12px;border-radius:12px;border:2px solid var(--border2);background:rgba(255,255,255,0.03);color:#fff;font-family:inherit;font-size:.85rem;outline:none}.form-group input:focus,.form-group select:focus{border-color:var(--p1)}
.multi-select{max-height:180px;overflow-y:auto;border:2px solid var(--border2);border-radius:12px;padding:8px;background:rgba(255,255,255,0.02)}.multi-select label{display:flex;align-items:center;gap:8px;padding:7px 10px;cursor:pointer;border-radius:8px;transition:var(--trans);color:var(--text2);font-size:.82rem}.multi-select label:hover{background:rgba(124,111,247,0.08);color:#fff}.multi-select input[type="checkbox"]{accent-color:var(--p1);width:16px;height:16px}
table{width:100%;border-collapse:collapse;font-size:.8rem}th{color:var(--t1);font-weight:700;padding:10px;text-align:left;border-bottom:2px solid var(--border)}td{padding:10px;border-bottom:1px solid var(--border)}.badge{padding:3px 10px;border-radius:16px;font-size:.68rem;font-weight:700}.badge-success{background:rgba(0,212,204,0.1);color:var(--t1)}.badge-danger{background:rgba(255,107,157,0.1);color:var(--a1)}
.server-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;background:rgba(0,0,0,0.25);padding:10px 12px;border-radius:14px;flex-wrap:wrap;border:1px solid rgba(255,255,255,0.03)}.server-row select,.server-row input{flex:1;min-width:70px;padding:9px 10px;border-radius:10px;border:2px solid var(--border2);background:rgba(255,255,255,0.02);color:#fff;font-family:inherit;font-size:.8rem;outline:none}.flag-select{font-size:1.4rem!important;text-align:center;max-width:65px!important;flex:0 0 65px!important}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;z-index:200;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:20px}.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:22px;padding:24px 20px;max-width:500px;width:100%;box-shadow:0 25px 50px rgba(0,0,0,0.6);position:relative}.modal h3{font-size:1.1rem;font-weight:900;margin-bottom:14px;text-align:center}.modal .close-btn{position:absolute;top:10px;right:12px;background:none;border:none;color:var(--text3);font-size:1.3rem;cursor:pointer}.alert{padding:10px 16px;border-radius:12px;margin-bottom:16px;font-size:.84rem}.alert-success{background:rgba(0,212,204,0.08);border:1px solid rgba(0,212,204,0.2);color:var(--t1)}.alert-error{background:rgba(255,107,157,0.08);color:var(--a1)}@media(max-width:768px){.form-grid{grid-template-columns:1fr}.server-row{flex-direction:column}}
</style></head><body>
<?php if(!$isLoggedIn): ?><div class="login-wrap"><div class="login-card"><img src="/alexvpn.png"><h1>Admin Panel</h1><form method="post"><input type="email" name="email" placeholder="Email" required><input type="password" name="password" placeholder="Password" required><button type="submit" class="btn btn-primary" style="width:100%;">Login</button></form><?php if(!file_exists($adminFile)): ?><p style="margin-top:12px;font-size:.8rem;"><a href="/install.php" style="color:var(--t1);">Setup</a></p><?php endif; ?></div></div>
<?php else: ?>
<div class="admin-header"><div class="inner"><span style="font-weight:900;">AlexVPN Admin</span><div style="display:flex;gap:8px;"><a href="<?php echo SITE_URL; ?>/" class="btn btn-outline btn-sm">Site</a><span style="color:var(--text3);"><?php echo $_SESSION['admin_email']??''; ?></span><a href="?logout=1" class="btn btn-danger btn-sm">Logout</a></div></div></div>
<div class="admin-wrap"><?php if($message): ?><div class="alert alert-<?php echo $messageType; ?>"><?php echo $messageType==='success'?'OK':'Error'; ?>: <?php echo $message; ?></div><?php endif; ?>
<div class="stats-grid"><div class="stat-card"><div class="v"><?php echo $tp; ?></div><div class="l">Plans (<?php echo $ap; ?> active)</div></div><div class="stat-card"><div class="v"><?php echo $ts; ?></div><div class="l">Servers</div></div><div class="stat-card"><div class="v"><?php echo $to; ?></div><div class="l">Orders</div></div><div class="stat-card"><div class="v"><?php echo number_format($tr); ?></div><div class="l">Revenue (T)</div></div><div class="stat-card"><div class="v" style="color:<?php echo $pc>0?'#fdcb6e':'var(--t1)'; ?>"><?php echo $pc; ?></div><div class="l">Pending</div></div></div>
<div class="tabs"><button class="tab-btn active" data-tab="plans">Plans</button><button class="tab-btn" data-tab="add">+ Add</button><button class="tab-btn" data-tab="pending">Pending (<?php echo $pc; ?>)</button><button class="tab-btn" data-tab="servers">Servers</button><button class="tab-btn" data-tab="settings">Settings</button><button class="tab-btn" data-tab="orders">Orders</button><button class="tab-btn" data-tab="reset" style="color:var(--a1);">Reset</button></div>

<div class="tab-content active" id="tab-plans"><div class="card"><?php if(empty($plans)): ?><p style="text-align:center;color:var(--text3);padding:30px;">No plans.</p><?php else: ?><div style="overflow-x:auto;"><table><thead><tr><th>Name</th><th>Location</th><th>Volume</th><th>Days</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody><?php foreach($plans as $p): ?><tr><td><strong><?php echo htmlspecialchars($p['name']); ?></strong> <?php echo ($p['featured']??false)?'⭐':''; ?><?php if($p['multi_location']??false): ?><br><small style="color:var(--t1);">Multi</small><?php endif; ?></td><td><?php echo htmlspecialchars($p['location_emoji']??'🌍'); ?> <?php echo htmlspecialchars($p['location_name']??''); ?></td><td><?php echo (int)$p['volume']; ?> GB</td><td><?php echo (int)$p['days']; ?> days</td><td><strong><?php echo number_format((int)$p['price']); ?></strong></td><td><span class="badge <?php echo ($p['active']??true)?'badge-success':'badge-danger'; ?>"><?php echo ($p['active']??true)?'Active':'Inactive'; ?></span></td><td><div style="display:flex;gap:4px;"><button class="btn btn-outline btn-xs" onclick="editPlan('<?php echo $p['id']; ?>','<?php echo htmlspecialchars(addslashes($p['name'])); ?>',<?php echo json_encode($p['locations']??[$p['location']]); ?>,'<?php echo (int)$p['volume']; ?>','<?php echo (int)$p['days']; ?>','<?php echo (int)$p['price']; ?>',<?php echo ($p['featured']??false)?'true':'false'; ?>)">Edit</button><a href="?toggle=<?php echo $p['id']; ?>" class="btn btn-outline btn-xs">Toggle</a><a href="?duplicate=<?php echo $p['id']; ?>" class="btn btn-outline btn-xs">Copy</a><a href="?delete=<?php echo $p['id']; ?>&confirm=yes" class="btn btn-danger btn-xs" onclick="return confirm('Delete?')">Del</a></div></td></tr><?php endforeach; ?></tbody></table></div><?php endif; ?></div></div>

<div class="tab-content" id="tab-add"><div class="card"><form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="add_plan" value="1"><div class="form-grid"><div class="form-group"><label>Plan Name</label><input type="text" name="name" required></div><div class="form-group"><label>Volume (GB)</label><input type="number" name="volume" value="30" min="1"></div><div class="form-group"><label>Days</label><input type="number" name="days" value="30" min="1"></div><div class="form-group"><label>Price (Toman)</label><input type="number" name="price" value="150000" min="1000"></div></div><div class="form-group"><label>Select Servers (Multi-Location)</label><div class="multi-select"><button type="button" class="btn btn-outline btn-xs" onclick="toggleAll(this,'add-loc')" style="margin-bottom:6px;">Select All</button><?php foreach($servers as $s): ?><label><input type="checkbox" name="server_locations[]" value="<?php echo $s['location']; ?>" class="add-loc"> <?php echo $s['location_emoji']??'🌍'; ?> <?php echo $s['location_name']; ?></label><?php endforeach; ?><?php if(empty($servers)): ?><p style="color:var(--text3);padding:8px;">No servers - Add in Servers tab</p><?php endif; ?></div></div><div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="featured" style="width:auto;"> Featured</label></div><button type="submit" class="btn btn-success" style="width:100%;">Add Plan</button></form></div></div>

<div class="tab-content" id="tab-pending"><div class="card"><?php if(empty($pendingList)): ?><p style="text-align:center;color:var(--text3);padding:30px;">Nothing pending.</p><?php else: ?><div style="overflow-x:auto;"><table><thead><tr><th>User</th><th>Plan</th><th>Amount</th><th>Receipt</th><th>Actions</th></tr></thead><tbody><?php foreach(array_reverse($pendingList) as $pp): ?><tr><td><?php echo htmlspecialchars($pp['user_name']??''); ?></td><td><?php echo htmlspecialchars($pp['plan_name']??''); ?></td><td><?php echo number_format((int)($pp['price']??0)); ?> T</td><td><?php if(!empty($pp['receipt'])): ?><a href="/data/receipts/<?php echo basename($pp['receipt']); ?>" target="_blank" class="btn btn-outline btn-xs">View</a><?php endif; ?></td><td><form method="post" action="/admin-approve.php" style="display:inline;"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="pending_id" value="<?php echo $pp['id']; ?>"><button name="action" value="approve" class="btn btn-success btn-xs">Approve</button></form> <button class="btn btn-danger btn-xs" onclick="rejectPayment('<?php echo $pp['id']; ?>')">Reject</button></td></tr><?php endforeach; ?></tbody></table></div><?php endif; ?></div></div>

<div class="tab-content" id="tab-servers"><div class="card"><form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="save_servers" value="1"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><h3>Servers (<?php echo $ts; ?>)</h3><button type="button" class="btn btn-success btn-sm" onclick="addServerRow()">+ Add Server</button></div><div id="serversContainer"><?php foreach($servers as $s): ?><div class="server-row"><select name="server_flag[]" class="flag-select"><?php foreach($allFlags as $code=>$flag): ?><option value="<?php echo $flag; ?>" <?php echo ($s['location_emoji']??'')===$flag?'selected':''; ?>><?php echo $flag; ?></option><?php endforeach; ?></select><input type="text" name="server_name[]" value="<?php echo htmlspecialchars($s['location_name']); ?>" placeholder="Name"><input type="text" name="server_code[]" value="<?php echo htmlspecialchars($s['location']); ?>" placeholder="Code"><input type="text" name="server_inbounds[]" value="<?php echo implode(',',$s['inbounds']??[]); ?>" placeholder="Inbounds"><button type="button" class="btn btn-danger btn-xs" onclick="this.parentElement.remove()">X</button></div><?php endforeach; ?><?php if(empty($servers)): ?><div class="server-row"><select name="server_flag[]" class="flag-select"><?php foreach($allFlags as $code=>$flag): ?><option value="<?php echo $flag; ?>"><?php echo $flag; ?></option><?php endforeach; ?></select><input type="text" name="server_name[]" placeholder="Name"><input type="text" name="server_code[]" placeholder="Code"><input type="text" name="server_inbounds[]" placeholder="Inbounds"></div><?php endif; ?></div><button type="submit" class="btn btn-primary" style="width:100%;margin-top:10px;">Save Servers</button></form></div></div>

<div class="tab-content" id="tab-settings"><div class="card"><form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="save_settings" value="1"><h4 style="color:var(--p1);margin-bottom:10px;">Card to Card</h4><div class="form-grid"><div class="form-group"><label>Card Number</label><input type="text" name="card_number" value="<?php echo htmlspecialchars($settings['card_number']??''); ?>"></div><div class="form-group"><label>Card Holder</label><input type="text" name="card_holder" value="<?php echo htmlspecialchars($settings['card_holder']??''); ?>"></div><div class="form-group"><label>Bank</label><input type="text" name="card_bank" value="<?php echo htmlspecialchars($settings['card_bank']??''); ?>"></div></div><h4 style="color:var(--p1);margin:14px 0 10px;">Payment Methods</h4><div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="zarinpal_enabled" <?php echo ($settings['zarinpal_enabled']??true)?'checked':''; ?> style="width:auto;"> Zarinpal</label></div><div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="card_enabled" <?php echo ($settings['card_enabled']??true)?'checked':''; ?> style="width:auto;"> Card to Card</label></div><button type="submit" class="btn btn-primary" style="width:100%;">Save Settings</button></form></div></div>

<div class="tab-content" id="tab-orders"><div class="card"><?php if(empty($orders)): ?><p style="text-align:center;color:var(--text3);padding:30px;">No orders.</p><?php else: ?><div style="overflow-x:auto;"><table><thead><tr><th>Date</th><th>User</th><th>Product</th><th>Amount</th><th>Link</th></tr></thead><tbody><?php foreach(array_reverse($orders) as $o): ?><tr><td><?php echo htmlspecialchars($o['date']??''); ?></td><td><?php echo htmlspecialchars($o['username']??'-'); ?></td><td><?php echo htmlspecialchars($o['product']??'-'); ?></td><td><?php echo number_format((int)($o['amount']??0)); ?> T</td><td><?php if(!empty($o['subscription_url'])): ?><a href="<?php echo htmlspecialchars($o['subscription_url']); ?>" target="_blank" class="btn btn-outline btn-xs">Link</a><?php endif; ?></td></tr><?php endforeach; ?></tbody></table></div><?php endif; ?></div></div>

<div class="tab-content" id="tab-reset"><div class="card" style="text-align:center;"><h3 style="color:var(--a1);">Reset Stats</h3><p style="color:var(--text3);font-size:.78rem;margin-bottom:14px;">Only orders and pending payments cleared.</p><form method="post" onsubmit="return confirm('Are you sure?')"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="reset_stats" value="CONFIRM"><button type="submit" class="btn btn-danger" style="width:100%;">Reset Stats</button></form></div></div>
</div>

<div class="modal-overlay" id="editModal" style="display:none;"><div class="modal"><button class="close-btn" onclick="closeEdit()">✕</button><h3>Edit Plan</h3><form method="post"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="edit_plan" value="1"><input type="hidden" name="plan_id" id="eId"><div class="form-grid"><div class="form-group"><label>Name</label><input type="text" name="name" id="eName" required></div><div class="form-group"><label>Volume</label><input type="number" name="volume" id="eVol" min="1"></div><div class="form-group"><label>Days</label><input type="number" name="days" id="eDays" min="1"></div><div class="form-group"><label>Price</label><input type="number" name="price" id="ePrice" min="1000"></div></div><div class="form-group"><label>Select Servers</label><div class="multi-select"><button type="button" class="btn btn-outline btn-xs" onclick="toggleAll(this,'edit-loc')" style="margin-bottom:6px;">Select All</button><?php foreach($servers as $s): ?><label><input type="checkbox" name="server_locations[]" value="<?php echo $s['location']; ?>" class="edit-loc"> <?php echo $s['location_emoji']??'🌍'; ?> <?php echo $s['location_name']; ?></label><?php endforeach; ?></div></div><div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" name="featured" id="eFeat" style="width:auto;"> Featured</label></div><div style="display:flex;gap:8px;justify-content:flex-end;"><button type="button" class="btn btn-outline" onclick="closeEdit()">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></div></div>

<div class="modal-overlay" id="rejectModal" style="display:none;"><div class="modal"><button class="close-btn" onclick="document.getElementById('rejectModal').style.display='none'">✕</button><h3>Reject</h3><form method="post" action="/admin-approve.php"><input type="hidden" name="csrf_token" value="<?php echo $_SESSION['csrf_token']; ?>"><input type="hidden" name="action" value="reject"><input type="hidden" name="pending_id" id="rejectPendingId"><div class="form-group"><label>Reason</label><input type="text" name="reject_reason" required></div><button type="submit" class="btn btn-danger" style="width:100%;">Submit</button></form></div></div>
<?php endif; ?>
<script>
function toggleAll(btn,cls){var cbs=document.querySelectorAll('.'+cls);var all=true;for(var i=0;i<cbs.length;i++){if(!cbs[i].checked)all=false}for(var i=0;i<cbs.length;i++){cbs[i].checked=!all}btn.textContent=all?'Select All':'Deselect All'}
function editPlan(id,name,locations,vol,days,price,feat){document.getElementById('eId').value=id;document.getElementById('eName').value=name;document.getElementById('eVol').value=vol;document.getElementById('eDays').value=days;document.getElementById('ePrice').value=price;document.getElementById('eFeat').checked=feat;var cbs=document.querySelectorAll('.edit-loc');for(var i=0;i<cbs.length;i++)cbs[i].checked=false;if(Array.isArray(locations)){for(var j=0;j<locations.length;j++){var cb=document.querySelector('.edit-loc[value="'+locations[j]+'"]');if(cb)cb.checked=true}}document.getElementById('editModal').style.display='flex'}
function closeEdit(){document.getElementById('editModal').style.display='none'}
document.getElementById('editModal').addEventListener('click',function(e){if(e.target===this)closeEdit()})
function rejectPayment(id){document.getElementById('rejectPendingId').value=id;document.getElementById('rejectModal').style.display='flex'}
document.getElementById('rejectModal').addEventListener('click',function(e){if(e.target===this)this.style.display='none'})
document.querySelectorAll('.tab-btn').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('.tab-btn').forEach(function(x){x.classList.remove('active')});document.querySelectorAll('.tab-content').forEach(function(x){x.classList.remove('active')});this.classList.add('active');document.getElementById('tab-'+this.dataset.tab).classList.add('active')})})
function addServerRow(){var flags=<?php echo json_encode($allFlags); ?>;var o='';for(var c in flags)o+='<option value="'+flags[c]+'">'+flags[c]+'</option>';var r=document.createElement('div');r.className='server-row';r.innerHTML='<select name="server_flag[]" class="flag-select">'+o+'</select><input type="text" name="server_name[]" placeholder="Name"><input type="text" name="server_code[]" placeholder="Code"><input type="text" name="server_inbounds[]" placeholder="Inbounds"><button type="button" class="btn btn-danger btn-xs" onclick="this.parentElement.remove()">X</button>';document.getElementById('serversContainer').appendChild(r)}
</script>
</body></html>
