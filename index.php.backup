    <script>
    document.querySelectorAll('.loc-tab').forEach(t=>t.addEventListener('click',function(){document.querySelectorAll('.loc-tab').forEach(x=>x.classList.remove('active'));this.classList.add('active');document.querySelectorAll('.plans-grid').forEach(g=>g.classList.remove('active'));var g=document.querySelector('.plans-grid[data-loc="'+this.dataset.loc+'"]');if(g)g.classList.add('active')}));
    function openCard(id){document.getElementById('cardPlanId').value=id;document.getElementById('cardModal').style.display='flex'}
    function closeCard(){document.getElementById('cardModal').style.display='none'}
    document.getElementById('cardModal')?.addEventListener('click',function(e){if(e.target===this)closeCard()});
    document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',function(e){var t=document.querySelector(this.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'})}}));
    </script>
