<?php
require_once __DIR__ . '/config.php';
$isUserLoggedIn = isLoggedIn();
$user = getCurrentUser();

if (isset($_POST['buy_zarinpal']) && isset($_POST['plan_id']) && $isUserLoggedIn) {
    $plans = loadPlans(); $planId = $_POST['plan_id']; $selectedPlan = null;
    foreach ($plans as $p) { if ($p['id'] === $planId && ($p['active'] ?? true)) { $selectedPlan = $p; break; } }
    if ($selectedPlan) {
        $amount = $selectedPlan['price'] * 10;
        $paymentData = ['merchant_id'=>MERCHANT_ID,'amount'=>$amount,'callback_url'=>CALLBACK_URL,'description'=>$selectedPlan['name']];
        $ch = curl_init('https://api.zarinpal.com/pg/v4/payment/request.json');
        curl_setopt_array($ch,[CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>json_encode($paymentData),CURLOPT_RETURNTRANSFER=>true,CURLOPT_HTTPHEADER=>['Content-Type: application/json','Accept: application/json'],CURLOPT_TIMEOUT=>30]);
        $payResponse = curl_exec($ch); curl_close($ch);
        $payResult = json_decode($payResponse, true);
        if (isset($payResult['data']['code']) && $payResult['data']['code']===100) {
            $_SESSION['alexvpn_payment'] = ['amount'=>$amount,'volume'=>$selectedPlan['volume'],'days'=>$selectedPlan['days'],'inbounds'=>$selectedPlan['inbounds']??ALL_INBOUNDS,'product_name'=>$selectedPlan['name'],'location_name'=>$selectedPlan['location_name']??'','price'=>$selectedPlan['price']];
            header('Location: https://www.zarinpal.com/pg/StartPay/'.$payResult['data']['authority']); exit;
        }
    }
}

$plans = loadPlans(); $settings = loadSettings(); $servers = loadServers();
$plansByLocation = [];
foreach ($plans as $plan) { if ($plan['active']??true) { $loc=$plan['location']??'other'; if(!isset($plansByLocation[$loc])) $plansByLocation[$loc]=[]; $plansByLocation[$loc][]=$plan; } }
$totalServers = count($servers);
$totalUsers = count(loadUsers());
?>
